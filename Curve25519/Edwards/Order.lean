module
public import Curve25519.Edwards.Basepoint
public import Curve25519.Edwards.Torsion
import Curve25519.ToEllipticCurve.TwistedEdwards.Lemmas
public section

/-! # The group of points of curve25519

`edwards.Point` is finite of cardinality `8 L` (`card_edwards`), cyclic
(`instIsAddCyclicEdwardsPoint`), generated by `torsion8 + basepoint` of order `8 L`
(`zmultiples_torsion8_add_basepoint_eq_top`), and every point decomposes uniquely as
`eightTorsion i + n • basepoint` with `i < 8`, `n < L` (`exists_unique_decomposition`): the
8-torsion is `{eightTorsion i}` (`eight_nsmul_eq_zero_iff`) and the prime-order subgroup is
`{n • basepoint}` (`L_nsmul_eq_zero_iff`). The cardinality is pinned from above by the generic
bound of at most two points for each `y` (`card_edwards_le`, so `card ≤ 2 p < 16 L`) and from
below by `8 L ∣ card` (Lagrange, for `torsion8 + basepoint`). The same cardinality holds for
`curve.Point` and `montgomery.Point` (`card_curve`, `card_montgomery`). Cardinalities are
`Nat.card`. -/

namespace curve25519

open TwistedEdwardsModel

/-! ### The cardinality bound -/

/-- At most `2 p` points: at most two for each `y`. -/
theorem card_edwards_le : Nat.card edwards.Point ≤ 2 * p := by
  have h := natCard_point_le (E := edwards)
  rwa [Nat.card_zmod] at h

/-! ### The cardinality -/

theorem coprime_eight_L : Nat.Coprime 8 L := by
  have h2 : Nat.Coprime 2 L :=
    (Nat.coprime_primes Nat.prime_two L_prime).mpr
      (ne_of_lt (lt_trans (by norm_num) two_pow_252_lt_L))
  exact h2.pow_left 3

/-- `torsion8 + basepoint` has order `8 L`. -/
theorem addOrderOf_torsion8_add_basepoint : addOrderOf (torsion8 + basepoint) = 8 * L := by
  rw [(AddCommute.all torsion8 basepoint).addOrderOf_add_eq_mul_addOrderOf_of_coprime
    (by rw [addOrderOf_torsion8, addOrderOf_basepoint]; exact coprime_eight_L),
    addOrderOf_torsion8, addOrderOf_basepoint]

theorem eight_mul_L_dvd_card : 8 * L ∣ Nat.card edwards.Point :=
  addOrderOf_torsion8_add_basepoint ▸ addOrderOf_dvd_natCard _

theorem two_mul_p_lt_sixteen_mul_L : 2 * p < 16 * L := by
  have h1 := p_lt_two_pow_255
  have h2 := two_pow_252_lt_L
  have h3 : (2 : ℕ) ^ 255 = 8 * 2 ^ 252 := by norm_num
  omega

/-- **The cardinality**: `edwards.Point` has `8 L` elements. -/
theorem card_edwards : Nat.card edwards.Point = 8 * L :=
  Nat.eq_of_dvd_of_lt_two_mul Nat.card_pos.ne' eight_mul_L_dvd_card
    (by have := card_edwards_le; have := two_mul_p_lt_sixteen_mul_L; omega)

/-- Every point is killed by `8 L`. -/
theorem eight_mul_L_nsmul (P : edwards.Point) : (8 * L) • P = 0 :=
  card_edwards ▸ card_nsmul_eq_zero'

/-- The group of points is cyclic, generated by `torsion8 + basepoint`. -/
instance instIsAddCyclicEdwardsPoint : IsAddCyclic edwards.Point :=
  isAddCyclic_of_addOrderOf_eq_card _
    (addOrderOf_torsion8_add_basepoint.trans card_edwards.symm)

/-- The generator `torsion8 + basepoint` of `edwards.Point`. -/
theorem zmultiples_torsion8_add_basepoint_eq_top :
    AddSubgroup.zmultiples (torsion8 + basepoint) = ⊤ :=
  AddSubgroup.eq_top_of_card_eq _ (by
    rw [Nat.card_zmultiples, addOrderOf_torsion8_add_basepoint, card_edwards])

/-! ### The decomposition `ℤ/8 × ℤ/L` -/

/-- `(i, n) ↦ eightTorsion i + n • basepoint`. -/
private noncomputable def decomp (q : Fin 8 × Fin L) : edwards.Point :=
  eightTorsion q.1 + (q.2 : ℕ) • basepoint

/-- `5 L ≡ 1 (mod 8)`, so `(5 L) • torsion8 = torsion8`. -/
private theorem five_mul_L_nsmul_torsion8 : (5 * L) • torsion8 = torsion8 := by
  rw [← mod_addOrderOf_nsmul, addOrderOf_torsion8]
  have h : 5 * L % 8 = 1 := by rw [L_eq_numeral]
  rw [h, one_nsmul]

private theorem five_mul_L_nsmul_basepoint : (5 * L) • basepoint = 0 := by
  rw [← smul_smul, L_nsmul_basepoint, smul_zero]

private theorem decomp_injective : Function.Injective decomp := by
  rintro ⟨i, n⟩ ⟨i', n'⟩ h
  change eightTorsion i + (n : ℕ) • basepoint = eightTorsion i' + (n' : ℕ) • basepoint at h
  have h5 : (5 * L) • (eightTorsion i + (n : ℕ) • basepoint) =
      (5 * L) • (eightTorsion i' + (n' : ℕ) • basepoint) := by
    rw [h]
  rw [smul_add, smul_add, eightTorsion_apply, eightTorsion_apply, smul_comm (5 * L) (i : ℕ),
    smul_comm (5 * L) (i' : ℕ), smul_comm (5 * L) (n : ℕ), smul_comm (5 * L) (n' : ℕ),
    five_mul_L_nsmul_torsion8, five_mul_L_nsmul_basepoint, smul_zero, smul_zero, add_zero, add_zero,
    ← eightTorsion_apply, ← eightTorsion_apply] at h5
  obtain rfl := eightTorsion_injective h5
  have hn : (n : ℕ) • basepoint = (n' : ℕ) • basepoint := add_left_cancel h
  rw [nsmul_eq_nsmul_iff_modEq, addOrderOf_basepoint] at hn
  rw [Fin.ext (hn.eq_of_lt_of_lt n.isLt n'.isLt)]

private theorem decomp_bijective : Function.Bijective decomp :=
  decomp_injective.bijective_of_nat_card_le (by
    rw [card_edwards, Nat.card_prod, Nat.card_fin, Nat.card_fin])

/-- **The decomposition**: every point is uniquely `eightTorsion i + n • basepoint` with `i < 8`
and `n < L`. -/
theorem exists_unique_decomposition (P : edwards.Point) :
    ∃! q : Fin 8 × Fin L, P = eightTorsion q.1 + (q.2 : ℕ) • basepoint := by
  obtain ⟨q, hq, huniq⟩ := decomp_bijective.existsUnique P
  exact ⟨q, hq.symm, fun q' hq' => huniq q' hq'.symm⟩

/-- The 8-torsion is `{eightTorsion i}`. -/
theorem eight_nsmul_eq_zero_iff (P : edwards.Point) :
    8 • P = 0 ↔ ∃ i : Fin 8, P = eightTorsion i := by
  constructor
  · intro h
    obtain ⟨⟨i, n⟩, hq, -⟩ := exists_unique_decomposition P
    refine ⟨i, ?_⟩
    rw [hq] at h ⊢
    rw [smul_add, eight_nsmul_eightTorsion, zero_add, smul_smul] at h
    have hL : L ∣ 8 * n := by
      have hd := addOrderOf_dvd_of_nsmul_eq_zero h
      rwa [addOrderOf_basepoint] at hd
    have hn : (n : ℕ) = 0 :=
      Nat.eq_zero_of_dvd_of_lt (coprime_eight_L.symm.dvd_of_dvd_mul_left hL) n.isLt
    rw [hn, zero_nsmul, add_zero]
  · rintro ⟨i, rfl⟩
    exact eight_nsmul_eightTorsion i

/-- The prime-order subgroup is `{n • basepoint}`. -/
theorem L_nsmul_eq_zero_iff (P : edwards.Point) : L • P = 0 ↔ ∃ n : ℕ, P = n • basepoint := by
  constructor
  · intro h
    obtain ⟨⟨i, n⟩, hq, -⟩ := exists_unique_decomposition P
    refine ⟨n, ?_⟩
    rw [hq] at h ⊢
    rw [smul_add, eightTorsion_apply, smul_comm L (i : ℕ), smul_comm L (n : ℕ),
      L_nsmul_basepoint, smul_zero, add_zero, smul_smul] at h
    have h8 : 8 ∣ i * L := by
      have hd := addOrderOf_dvd_of_nsmul_eq_zero h
      rwa [addOrderOf_torsion8] at hd
    have hi : (i : ℕ) = 0 :=
      Nat.eq_zero_of_dvd_of_lt (coprime_eight_L.dvd_of_dvd_mul_right h8) i.isLt
    rw [eightTorsion_apply, hi, zero_nsmul, zero_add]
  · rintro ⟨n, rfl⟩
    rw [smul_comm, L_nsmul_basepoint, smul_zero]

/-! ### The curve and the Montgomery model -/

/-- The curve has `8 L` points. -/
theorem card_curve : Nat.card curve.Point = 8 * L := by
  rw [← toCurve_edwards, ← Nat.card_congr edwards.pointEquiv.toEquiv, card_edwards]

/-- The Montgomery model has `8 L` points. -/
theorem card_montgomery : Nat.card montgomery.Point = 8 * L := by
  rw [Nat.card_congr montgomery.pointEquiv.toEquiv, toCurve_montgomery, card_curve]

end curve25519
