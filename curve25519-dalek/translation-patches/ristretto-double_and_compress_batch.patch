                 let Zinv = &state.eg * inv;
                 let Tinv = &state.fh * inv;
 
                 let mut magic = constants::INVSQRT_A_MINUS_D;
 
                 let negcheck1 = (&state.eg * &Zinv).is_negative();
 
                 let mut e = state.e;
                 let mut g = state.g;
                 let mut h = state.h;
 
                 let minus_e = -&e;
                 let f_times_sqrta = &state.f * &constants::SQRT_M1;
 
