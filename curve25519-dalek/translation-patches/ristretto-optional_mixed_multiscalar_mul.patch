Translation patch: <VartimeRistrettoPrecomputation as VartimePrecomputedMultiscalarMul>::optional_mixed_multiscalar_mul

Change: the lazy `dynamic_points.map(..)` becomes a `Vec` built by a `for` loop.
Why: Aeneas only models `Iterator::next` (aeneas#1057).
Behaviour: same result for finite inputs, not identical: all dynamic points are read, even after a
`None`, before the scalars (so input infinite after a `None` no longer terminates).

diff --git a/curve25519-dalek/src/ristretto.rs b/curve25519-dalek/src/ristretto.rs
index 269662d..174f38b 100644
--- a/curve25519-dalek/src/ristretto.rs
+++ b/curve25519-dalek/src/ristretto.rs
@@ -1028,22 +1028,27 @@ fn is_empty(&self) -> bool {
     fn optional_mixed_multiscalar_mul<I, J, K>(
         &self,
         static_scalars: I,
         dynamic_scalars: J,
         dynamic_points: K,
     ) -> Option<Self::Point>
     where
         I: IntoIterator,
         I::Item: Borrow<Scalar>,
         J: IntoIterator,
         J::Item: Borrow<Scalar>,
         K: IntoIterator<Item = Option<Self::Point>>,
     {
+        let mut extended_points = vec![];
+        for P_opt in dynamic_points {
+            extended_points.push(P_opt.map(|P| P.0));
+        }
+
         self.0
             .optional_mixed_multiscalar_mul(
                 static_scalars,
                 dynamic_scalars,
-                dynamic_points.into_iter().map(|P_opt| P_opt.map(|P| P.0)),
+                extended_points,
             )
             .map(RistrettoPoint)
     }
 }
